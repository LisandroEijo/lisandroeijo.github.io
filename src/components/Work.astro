---
const projects = [
  {
    image: '/images/proyect-gallery_smart-savings.png',
    title: 'Smart Savings',
    link:  'https://www.behance.net/gallery/245960381/Smart-Savings-Bank-app-feature',
  },
  {
    image: '/images/proyect-gallery_floraknow.png',
    title: 'FloraKnow',
    link:  'https://www.behance.net/gallery/196002239/FloraKnow-Plant-Care-App',
  },
  {
    image: '/images/proyect-gallery_Ripio-rpc.png',
    title: 'Ripio RPC',
    link:  'https://www.behance.net/gallery/156711107/Sorteo-Qatar-RPC',
  },
  {
    image: '/images/proyect-gallery_HCI.png',
    title: 'HCI',
    link:  'https://www.behance.net/gallery/123602481/HCI-03-INTERNAL-COMMUNICATION-TOOL-UXUI-DESIGN',
  },
  {
    image: '/images/proyect-gallery_Nuin.png',
    title: 'Nuin',
    link:  'https://www.behance.net/gallery/114174817/Nuin-App',
  },
];
---

<section id="work" class="work">
  <div class="container">
    <h2 class="work__title">Featured Work</h2>
    <div class="work__carousel">
      <button class="work__arrow work__arrow--prev" aria-label="Previous"> <img src="images/arrow__left.svg" alt="previous">  </button>
      <div class="work__track-wrapper">
        <div class="work__track">
          {projects.map((project) => (
            <div class="work__card">
              <a href={project.link}>
                <img src={project.image} alt={project.title} />
              </a>
              {/* <p class="work__card-title">{project.title}</p> */}
            </div>
          ))}
        </div>
      </div>
      <button class="work__arrow work__arrow--next" aria-label="Next"> <img src="images/arrow__right.svg" alt="next"></button>
    </div>
    <div class="work__dots">
      {Array.from({ length: projects.length - 2 }).map((_, i) => (
        <button class={`work__dot ${i === 0 ? 'work__dot--active' : ''}`} aria-label={`Go to slide ${i + 1}`} />
      ))}
    </div>
    <div class="btn__container">
      <a href="https://www.behance.net/LisandroEijo" class="btn btn--outline">More of my work</a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .work {
    padding: $space-24 0;
    text-align: center;

    &__title {
      font-size: $font-size-h2;
      margin-bottom: $space-12;
      text-align: left;
    }

    &__carousel {
      display: flex;
      align-items: center;
      gap: $space-4;
    }

    &__track-wrapper {
      overflow: hidden;
      flex: 1;
      clip-path: inset(0);
    }

    &__track {
      display: flex;
      gap: $space-4;
      transition: transform 0.3s ease;
    }

    &__card {
      flex: 0 0 calc(33.333% - $space-4);
      overflow: hidden;
      
      img {
        width: 100%;
        //height: 200px;
        object-fit: cover;
        border-radius: $radius-md;
      }
    }

    &__card-title {
      font-size: $font-size-small;
      font-weight: $font-weight-bold;
      padding: $space-2 0;
      text-align: left;
    }

    &__arrow {
      font-size: 1.5rem;
      color: $color-primary;
      padding: $space-2;
      flex-shrink: 0;
      width: 50px;
      
    }

    &__dots {
      display: flex;
      justify-content: center;
      gap: $space-2;
      margin-top: $space-6;
    }
    
  }
  @media (max-width: #{$bp-md}) {
    .work {
      &__carousel{
        margin: 0 1rem;
      }
      &__card {
        flex: 0 0 calc(50% - $space-4);
      }
      &__arrow{
        width:36px;
        position: absolute;
        z-index: 1;
        left: 0;
        &--next{
          right: 0;
          left: initial;
        }
      }
    }
  }
  
  @media (max-width: #{$bp-sm}) {
    .work {
      &__card {
        flex: 0 0 100%;
      }
     
    }

  }
  
    
</style>
<style lang="scss" is:global>
  @use '../styles/tokens' as *;

  .work__dot {
    width: 24px;
    height: 4px;
    background-color: $neutral-200;
    transition: background-color 0.2s ease;
    border: none;
    padding: 0;
    cursor: pointer;

    &--active {
      background-color: $color-accent;
    }
  }
</style>

<script>
  const track = document.querySelector('.work__track') as HTMLElement;
  const dotsContainer = document.querySelector('.work__dots') as HTMLElement;
  const prevBtn = document.querySelector('.work__arrow--prev');
  const nextBtn = document.querySelector('.work__arrow--next');

  const cards = document.querySelectorAll('.work__card');
  const total = cards.length;
  let current = 0;

  function getVisible(): number {
    if (window.innerWidth <= 480) return 1;
    if (window.innerWidth <= 768) return 2;
    return 3;
  }

  function buildDots() {
    const visible = getVisible();
    const count = total - visible + 1;
    // console.log('dots count:', count);
    dotsContainer.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const btn = document.createElement('button');
      btn.className = `work__dot${i === current ? ' work__dot--active' : ''}`;
      btn.setAttribute('aria-label', `Go to slide ${i + 1}`);
      btn.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(btn);
    }
  }

  function goTo(index: number) {
    const visible = getVisible();
    const max = total - visible;
    current = Math.max(0, Math.min(index, max));

    const wrapper = document.querySelector('.work__track-wrapper') as HTMLElement;
    const gap = parseFloat(getComputedStyle(track).gap) || 16;
    const cardWidth = (wrapper.offsetWidth - gap * (visible - 1)) / visible;
    track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;

    document.querySelectorAll('.work__dot').forEach((dot, i) => {
      dot.classList.toggle('work__dot--active', i === current);
    });
  }

  function init() {
    current = 0;
    buildDots();
    goTo(0);
    console.log('dotsContainer:', dotsContainer);
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));
  window.addEventListener('resize', init);

  init();
</script>