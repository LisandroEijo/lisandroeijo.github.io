---
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  metaTag: string; 
  title: string;
  description: string;
  images: GalleryImage[];
}

const { metaTag, title, description, images } = Astro.props;
---

<section class="image-gallery">
  {metaTag && <p class="image-gallery__label">{metaTag}</p>}
  <h3 class="image-gallery__title">{title}</h3>
  <p class="image-gallery__description">{description}</p>
  <div class="image-gallery__grid">
    {images.map((image) => (
      <div class="image-gallery__container">
        <img class="image-gallery__image" src={image.src} alt={image.alt} />
      </div>
    ))}
  </div>

  <div class="image-gallery__modal" role="dialog" aria-modal="true" aria-label="Image gallery">
    <button class="image-gallery__close" aria-label="Close image">
      <span aria-hidden="true">✕</span>
    </button>
    <button class="image-gallery__nav image-gallery__nav--prev" aria-label="Previous image">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <img class="image-gallery__modal-image" src="" alt="" />
    <button class="image-gallery__nav image-gallery__nav--next" aria-label="Next image">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>

<style lang="scss">
  @use "../styles/tokens" as *;
  @use "../styles/typography" as *;

  .image-gallery {
    margin-bottom: 3.5rem;

    &__label {
      @extend .label--sm;
      color: $color-accent;
      margin-bottom: $space-2;
    }

    &__title {
      margin-bottom: $space-4;
    }

    &__description {
      color: $neutral-500;
      margin-bottom: $space-4;
      font-size: $font-size-body-big;
      max-width: 750px;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 10px;
      margin-top: 1.5rem;
    }

    &__container {
      //aspect-ratio: 16 / 9;
      width: 100%;
      border: 1px solid $neutral-100;
      border-radius: $radius-lg;
      padding: $space-1;
      overflow: hidden;
    }

    &__image {
      width: 100%;
      border-radius: 8px;
      cursor: zoom-in;
      transition: opacity 0.15s;

      &:hover {
        opacity: 0.85;
      }
    }

    &__modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      z-index: 1000;
      align-items: center;
      justify-content: center;

      &.is-open {
        display: flex;
      }
    }

    &__modal-image {
      max-height: 90vh;
      max-width: 90vw;
      border-radius: 8px;
      object-fit: contain;
    }

    &__close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: none;
      border: none;
      color: white;
      font-size: 1.25rem;
      cursor: pointer;
      opacity: 0.6;
      transition: opacity 0.15s;

      &:hover {
        opacity: 1;
      }
    }

    &__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 999px;
      color: white;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.15s;

      &:hover {
        opacity: 1;
      }

      &--prev {
        left: 1.5rem;
      }

      &--next {
        right: 1.5rem;
      }

      svg {
        width: 16px;
        height: 16px;
      }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".image-gallery").forEach((gallery) => {
    const images = [...gallery.querySelectorAll<HTMLImageElement>(".image-gallery__image")];
    const modal = gallery.querySelector<HTMLElement>(".image-gallery__modal");
    const modalImage = gallery.querySelector<HTMLImageElement>(".image-gallery__modal-image");
    const closeButton = gallery.querySelector<HTMLButtonElement>(".image-gallery__close");
    const previousButton = gallery.querySelector<HTMLButtonElement>(".image-gallery__nav--prev");
    const nextButton = gallery.querySelector<HTMLButtonElement>(".image-gallery__nav--next");

    if (!modal || !modalImage || !closeButton || !previousButton || !nextButton || images.length === 0) {
      return;
    }

    let currentIndex = 0;

    function openModal(index: number) {
      currentIndex = index;
      modalImage.src = images[currentIndex].src;
      modalImage.alt = images[currentIndex].alt;
      document.body.append(modal);
      modal.classList.add("is-open");
      closeButton.focus();
    }

    function closeModal() {
      modal.classList.remove("is-open");
      images[currentIndex].focus();
    }

    function navigate(direction: number) {
      currentIndex = (currentIndex + direction + images.length) % images.length;
      modalImage.src = images[currentIndex].src;
      modalImage.alt = images[currentIndex].alt;
    }

    images.forEach((image, index) => {
      image.tabIndex = 0;
      image.addEventListener("click", () => openModal(index));
      image.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openModal(index);
        }
      });
    });

    closeButton.addEventListener("click", closeModal);
    previousButton.addEventListener("click", () => navigate(-1));
    nextButton.addEventListener("click", () => navigate(1));

    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal();
    });

    document.addEventListener("keydown", (event) => {
      if (!modal.classList.contains("is-open")) return;
      if (event.key === "Escape") closeModal();
      if (event.key === "ArrowLeft") navigate(-1);
      if (event.key === "ArrowRight") navigate(1);
    });
  });
</script>
