---
import Base from "../../layouts/Base.astro";
import { selectedProjects as projects } from "../../data/projects";
import Contact from "../../components/Contact.astro";
---

<Base title="Lisandro Eijo — Senior UX/UI Designer">
    <section id="Work" class="work">
        <div class="container">
            <h1>Work</h1>
            <p>
                Fifteen years of designing products and the systems behind them.
                These projects show how I work across fintech, SaaS, and
                consumer apps, from untangling a messy problem to shipping a
                scalable design system.
            </p>
            <h2>Selected UX Projects</h2>
            <div class="Work-projects-gallery">
                {
                    projects.map((project, index) => (
                        <div class:list={[
                            "work-gallery__block",
                            { "work-gallery__block--even": index % 2 === 1 },
                        ]}>
                            <img
                                src={project.image}
                                alt={project.title}
                                class="project__image"
                            />
                            <div class="project__information">
                                <h3 class="project__title">{project.title}</h3>
                                <p class="project__subtitle">{project.subtitle}</p>
                                <div class="tag__container">
                                    {project.tags.map((tag) => (
                                        <span class="badge">{tag}</span>
                                    ))}
                                </div>
                                <p class="project__description">{project.description}</p>
                                <div class="btn__container">
                                    <a href={project.link} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
                                        See More
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
    <section id="contact">
        <Contact />
    </section>
</Base>

<style lang="scss">
    @use "../../styles/tokens" as *;
    @use "../../styles/typography" as *;

    .work {
        margin-top: $space-24;
        h1 {
            font-size: $font-size-h2;
            margin-bottom: $space-6;
        }

    }
    .work-gallery{
        &__block{
            display: flex;
            gap: $space-6;
            margin: $space-12 0;
        }
        &__block--even{
            flex-direction: row-reverse;
            .project__information{
                text-align: right;
                .btn__container{
                    justify-content: flex-end;
                }
            }
        }   
    }
    .project{
        &__image{
            max-width: 464px;
            height: auto;
            border-radius: $radius-md;
        }
       
        &__title{
            font-size: $font-size-h3;
            margin-bottom: $space-2;
        }
        &__subtitle{
            font-size: $font-size-body-big;
            margin-bottom: $space-4;
            color: $color-accent;
        }
    
    }
    .tag__container{
        display: flex;
        flex-wrap: wrap;
        gap: $space-2;
        margin: $space-4 0;
    }
    .tag {
        background-color: $color-primary;
        color: #fff;
        padding: $space-2 $space-4;
        border-radius: $radius-md;
        font-size: $font-size-small;
    }
</style>
