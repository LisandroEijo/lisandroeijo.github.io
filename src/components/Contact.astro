---
---

<section id="contact" class="contact">
  <div class="container">
    <p class="contact__question">Do you have any questions or would you like to discuss a project?</p>
    <p class="contact__cta">We can start a conversation.</p>

    <form class="contact__form" action="https://formspree.io/f/xnjgyzjd" method="POST">
      <input type="text" name="name" placeholder="Your name" required />
      <input type="email" name="email" placeholder="Your email" required />
      <textarea name="message" placeholder="Your message" rows="5" required></textarea>
      <button type="submit" class="btn btn--outline">Send message</button>
    </form>

    <p class="contact__social-label">You can also find my work on:</p>
    <ul class="contact__social">
      <li>
        <a href="https://linkedin.com/in/lisandroeijo" target="_blank" rel="noopener" aria-label="LinkedIn">
          <img src="/icons/Icon__Linkedin.svg" alt="LinkedIn" />
        </a>
      </li>
      <li>
        <a href="https://behance.net/lisandroeijo" target="_blank" rel="noopener" aria-label="Behance">
          <img src="/icons/Icon__Behance.svg" alt="Behance" />
        </a>
      </li>
      <li>
        <a href="https://dribbble.com/lisandroeijo" target="_blank" rel="noopener" aria-label="Dribbble">
          <img src="/icons/Icon__Dribbble.svg" alt="Dribbble" />
        </a>
      </li>
    </ul>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .contact {
    padding: $space-24 0;
    text-align: center;

    &__question {
      font-size: $font-size-body;
      // color: $color-text-light;
    }

    &__cta {
      font-size: $font-size-body;
      // color: $color-text-light;
      margin-top: $space-2;
    }

    &__form {
      display: flex;
      flex-direction: column;
      gap: $space-4;
      max-width: 560px;
      margin: $space-8 auto 0;

      input,
      textarea {
        width: 100%;
        padding: $space-3 $space-4;
        border: 1px solid $neutral-200;
        border-radius: $radius-md;
        font-family: $font-family;
        font-size: $font-size-body;
        color: $color-text;
        // background: $neutral-50;
        outline: none;
        transition: border-color 0.2s ease;

        &:focus {
          border-color: $color-primary;
          background-color: $neutral-50;
        }
      }

      textarea {
        resize: vertical;
      }
      button{
        display: inline-block;
      }
    }

    &__social-label {
      margin-top: $space-12;
      font-size: $font-size-small;
      color: $color-text-light;
    }

    &__social {
      display: flex;
      justify-content: center;
      gap: $space-16;
      margin-top: $space-4;

      img {
        width: 48px;
        height: 48px;
      }
    }
  }
</style>