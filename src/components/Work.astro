---
import { featuredProjects as projects } from "../data/projects";
---

<section id="work" class="work">
  <div class="container">
    <h2 class="work__title">Featured Work</h2>
    <div class="work__carousel">
      <button class="work__arrow work__arrow--prev" aria-label="Previous">
        <img
          src="images/arrow__left.svg"
          alt="previous"
          aria-label="Previous project"
        />
      </button>
      <div class="work__track-wrapper">
        <div class="work__track">
          {
            projects.map((project) => (
              <div class="work__card">
                <a href={project.link}>
                  <img
                    src={project.image}
                    alt={project.title}
                    aria-label={project.label}
                  />
                </a>
                {/* <p class="work__card-title">{project.title}</p> */}
              </div>
            ))
          }
        </div>
      </div>
      <button class="work__arrow work__arrow--next" aria-label="Next">
        <img
          src="images/arrow__right.svg"
          alt="next"
          aria-label="Next project"
        /></button
      >
    </div>
    <div class="work__dots">
      {
        Array.from({ length: projects.length - 2 }).map((_, i) => (
          <button
            class={`work__dot ${i === 0 ? "work__dot--active" : ""}`}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))
      }
    </div>
    <div class="btn__container center">
      <a
        href="docs/Lisandro Eijo--Portfolio--2026.pdf"
        class="btn btn--outline"
        target="_blank"
        aria-label="Download my portfolio in PDF"
        rel="noopener noreferrer">portfolio in PDF</a
      >
      <a
        href="https://www.behance.net/LisandroEijo"
        class="btn btn--outline"
        target="_blank"
        rel="noopener noreferrer">See more</a
      >
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/tokens" as *;

  .work {
    padding: $space-24 0;
    text-align: center;

    &__title {
      font-size: $font-size-h2;
      margin-bottom: $space-12;
      text-align: left;
    }

    &__carousel {
      display: flex;
      align-items: center;
      gap: $space-4;
    }

    &__track-wrapper {
      overflow: hidden;
      flex: 1;
      clip-path: inset(0);
    }

    &__track {
      display: flex;
      gap: $space-4;
      transition: transform 0.3s ease;
    }

    &__card {
      flex: 0 0 calc(50% - $space-2);
      overflow: hidden;

      img {
        width: 100%;
        //height: 200px;
        object-fit: cover;
        border-radius: $radius-md;
      }
    }

    &__card-title {
      font-size: $font-size-small;
      font-weight: $font-weight-bold;
      padding: $space-2 0;
      text-align: left;
    }

    &__arrow {
      font-size: 1.5rem;
      color: $color-primary;
      padding: $space-2;
      flex-shrink: 0;
      width: 50px;
    }

    &__dots {
      display: flex;
      justify-content: center;
      gap: $space-2;
      margin-top: $space-6;
    }
  }
  @media (max-width: #{$bp-md}) {
    .work {
      &__carousel {
        margin: 0 1rem;
      }
      &__card {
        flex: 0 0 100%;
      }
      &__arrow {
        width: 36px;
        position: absolute;
        z-index: 1;
        left: 0;
        &--next {
          right: 0;
          left: initial;
        }
      }
    }
  }
</style>
<style lang="scss" is:global>
  @use "../styles/tokens" as *;

  .work__dot {
    width: 24px;
    height: 4px;
    background-color: $neutral-200;
    transition: background-color 0.2s ease;
    border: none;
    padding: 0;
    cursor: pointer;

    &--active {
      background-color: $color-accent;
    }
  }
</style>

<script>
  const track = document.querySelector(".work__track") as HTMLElement;
  const wrapper = document.querySelector(".work__track-wrapper") as HTMLElement;
  const dotsContainer = document.querySelector(".work__dots") as HTMLElement;
  const prevBtn = document.querySelector(".work__arrow--prev");
  const nextBtn = document.querySelector(".work__arrow--next");
  const cards = Array.from(
    document.querySelectorAll(".work__card"),
  ) as HTMLElement[];

  const total = cards.length;
  let current = 0;
  let lastVisible = 0;

  // Cuántas cards entran realmente, según lo que define el CSS
  function getVisible(): number {
    const gap = parseFloat(getComputedStyle(track).gap) || 0;
    const cardWidth = cards[0].offsetWidth;
    return Math.max(
      1,
      Math.floor((wrapper.offsetWidth + gap) / (cardWidth + gap)),
    );
  }

  function buildDots() {
    const count = Math.max(1, total - getVisible() + 1);
    dotsContainer.innerHTML = "";
    for (let i = 0; i < count; i++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "work__dot";
      btn.setAttribute("aria-label", `Go to slide ${i + 1}`);
      btn.addEventListener("click", () => goTo(i));
      dotsContainer.appendChild(btn);
    }
  }

  function goTo(index: number) {
    const max = Math.max(0, total - getVisible());
    current = Math.max(0, Math.min(index, max));

    const offset = cards[current].offsetLeft - cards[0].offsetLeft;
    track.style.transform = `translateX(-${offset}px)`;

    dotsContainer.querySelectorAll(".work__dot").forEach((dot, i) => {
      dot.classList.toggle("work__dot--active", i === current);
      if (i === current) dot.setAttribute("aria-current", "true");
      else dot.removeAttribute("aria-current");
    });

    prevBtn?.toggleAttribute("disabled", current === 0);
    nextBtn?.toggleAttribute("disabled", current >= max);
  }

  function onResize() {
    const visible = getVisible();
    if (visible !== lastVisible) {
      lastVisible = visible;
      buildDots();
    }
    goTo(current); // recalcula la posición sin volver al primer slide
  }

  prevBtn?.addEventListener("click", () => goTo(current - 1));
  nextBtn?.addEventListener("click", () => goTo(current + 1));
  window.addEventListener("resize", onResize);

  lastVisible = getVisible();
  buildDots();
  goTo(0);
</script>
